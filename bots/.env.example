# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# URL бэкенда (если на локальной машине, оставить как есть)
BACKEND_URL=http://45.159.209.70:8000

# Время жизни сессии на бэкенде (секунд) - должно совпадать с SESSION_TIMEOUT в config.py бэкенда
SESSION_TIMEOUT=3600

# Максимальный размер загружаемого файла в МБ
MAX_FILE_SIZE_MB=20

# Максимальная длина вопроса (символов)
MAX_QUESTION_LENGTH=1000

# Максимальное количество сообщений, хранимых в истории (в памяти)
MAX_HISTORY_STORED=200

# Максимальное количество сообщений, показываемых в /history
MAX_HISTORY_SHOWN=20

# Файл для сохранения данных бота (persistence)
PERSISTENCE_FILE=bot_data.pickle
RATE_LIMIT_SECONDS=2
MAX_RETRIES=2
RETRY_DELAY=1